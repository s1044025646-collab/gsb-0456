    "demo": "node dist/src/cli/cli.js demo",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
