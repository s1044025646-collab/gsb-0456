{
  "name": "fs-dither-backend",
  "version": "1.0.0",
  "description": "Floyd–Steinberg 二值化与误差传播核验后端（API + CLI）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
